           remote="lineage" revision="lineage-24.0" />
  <project path="vendor/qcom/opensource/audioreach-graphservices"
           name="android_vendor_qcom_opensource_audioreach-graphservices"
           remote="lineage" revision="lineage-24.0" />
  <project path="vendor/qcom/opensource/usb"
           name="android_vendor_qcom_opensource_usb"
           remote="lineage" revision="lineage-24.0" />
  <project path="vendor/qcom/opensource/vibrator"
           name="android_vendor_qcom_opensource_vibrator"
           remote="lineage" revision="lineage-24.0" />
  <project path="vendor/qcom/opensource/power"
           name="android_vendor_qcom_opensource_power"
           remote="lineage" revision="lineage-24.0" />
  <project path="vendor/qcom/opensource/data-ipa-cfg-mgr"
           name="android_vendor_qcom_opensource_data-ipa-cfg-mgr"
           remote="lineage" revision="lineage-24.0" />
  <project path="vendor/qcom/opensource/fm-commonsys"
           name="android_vendor_qcom_opensource_fm-commonsys"
           remote="lineage" revision="lineage-24.0" />
  <project path="vendor/qcom/opensource/libfmjni"
           name="android_vendor_qcom_opensource_libfmjni"
           remote="lineage" revision="lineage-24.0" />

  <!-- ===== crDroid-only packages referenced by device config ===== -->
  <project path="packages/apps/LunarisDolby"
           name="android_packages_apps_LunarisDolby"
           remote="crdroid" revision="17.0" />

</manifest>
